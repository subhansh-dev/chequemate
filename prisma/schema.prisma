generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Feedback left by judges, reviewers, and visitors of the Huewaves
// experience — searchable, rateable notes on the landing page.
model Feedback {
  id        String   @id @default(cuid())
  name      String
  role      String?
  message   String
  rating    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}